# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SQLite database path for the Node/Express persistence layer
FITVORA_SQLITE_PATH="./fitvora.db"

# Optional initial admin passcode (if unset, use the first-run Claim Admin setup in UI)
FITVORA_ADMIN_PASSCODE=""

# Java backend JDBC configuration (supply in production environment)
FITVORA_DB_DRIVER="com.mysql.cj.jdbc.Driver"
FITVORA_DB_URL=""
FITVORA_DB_USER=""
FITVORA_DB_PASSWORD=""
FITVORA_ALLOWED_ORIGIN=""
